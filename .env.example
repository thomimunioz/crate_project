# ============================================================
#  CRATE — variables de entorno (copiá a .env y completá)
# ============================================================

# ---- Frontend (Vite: deben empezar con VITE_) ----
# YouTube Data API v3 key  → https://console.cloud.google.com/  (habilitá "YouTube Data API v3")
VITE_YOUTUBE_API_KEY=

# Discogs personal access token → https://www.discogs.com/settings/developers
VITE_DISCOGS_TOKEN=

# User-Agent obligatorio para MusicBrainz y Discogs (identificá tu app)
VITE_APP_USER_AGENT=CRATE/0.1 (personal digging tool)

# URL del backend (en dev, Vite proxea /api → backend)
VITE_API_BASE=/api

# ---- Backend (FastAPI) ----
# Orígenes permitidos para CORS (coma-separados)
CRATE_ALLOWED_ORIGINS=http://localhost:5173

# Hosts permitidos para el proxy (allowlist, coma-separados) — evita proxy abierto
CRATE_PROXY_ALLOWLIST=api.discogs.com,musicbrainz.org,archive.org,bandcamp.com

# Segundos de audio a analizar por request (fragmento, no el track entero)
CRATE_ANALYZE_SECONDS=45

# Carpeta temporal para los fragmentos de yt-dlp (se limpia sola)
CRATE_TMP_DIR=./tmp
