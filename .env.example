# ============================================================
#  CRATE — variables de entorno (copiá a .env y completá)
#  Un solo .env en la raíz: lo leen el backend (pydantic-settings)
#  y el frontend (vite, via envDir).
# ============================================================

# ---- Frontend (Vite: se INLINEAN en el bundle público) ----
# Nunca poner secretos acá.
# YouTube Data API v3 → https://console.cloud.google.com/ (habilitá la API).
# Restringila por referrer desde la consola, no depende de ser secreta.
VITE_YOUTUBE_API_KEY=

# URL del backend (en dev, Vite proxea /api → localhost:8787)
VITE_API_BASE=/api

# ---- Backend (FastAPI) — acá sí van los secretos ----
# Discogs → https://www.discogs.com/settings/developers
# El consumer key + secret dan 60 req/min (sin auth son 25). Los inyecta el
# proxy del backend, así que nunca llegan al browser.
CRATE_DISCOGS_KEY=
CRATE_DISCOGS_SECRET=

# Identificación obligatoria para MusicBrainz y Discogs. Poné algo con contacto.
CRATE_APP_USER_AGENT=CRATE/0.1 (+https://github.com/tu-usuario/crate_project)

# Orígenes permitidos para CORS (coma-separados)
CRATE_ALLOWED_ORIGINS=http://localhost:5173

# Hosts permitidos para el proxy (allowlist) — evita proxy abierto
CRATE_PROXY_ALLOWLIST=api.discogs.com,musicbrainz.org,archive.org,bandcamp.com

# Segundos de audio a analizar por request (fragmento, no el track entero)
CRATE_ANALYZE_SECONDS=45

# Carpeta temporal para los fragmentos de yt-dlp (se limpia sola)
CRATE_TMP_DIR=./tmp
